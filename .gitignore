# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/bin/
env/Scripts/
# NOTE: env/ below is the SOURCE package (portfolio_env.py), NOT a virtualenv.
# It is tracked. Only virtualenv artifacts are ignored via the two lines above.

# --- Data (raw CSVs regenerated by data_loader; keep repo light) ---
data/raw/*.csv
data/processed/*.csv
data/processed/*.npz

# --- Training / experiment artifacts ---
results/**/*.png
results/**/*.zip
results/**/*.csv
runs/
tensorboard/
*.zip
checkpoints/

# keep placeholder files so empty dirs stay in git
!.gitkeep

# --- Thesis deliverables: keep the figures/tables the write-up cites ---
# Model .zip checkpoints stay ignored (large, regenerable by train.py); the
# data-check figures and the evaluation tables + figures are small and ARE the
# reported output, so they are tracked. Negations must be spelled out per
# directory level — a bare `dir/*.png` does not reach one level down.
!results/data_checks/
!results/data_checks/*.png
!results/evaluation/
!results/evaluation/*.png
!results/evaluation/*/
!results/evaluation/*/*.png
!results/evaluation/*/*.csv

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Colab reproduction bundle (see notebooks/colab_results.ipynb) ---
# The notebook clones this repo and regenerates every table and figure, so the
# inputs it needs must be tracked even though the patterns above exclude them:
#   * raw CSVs  -> otherwise data_loader re-downloads and the data differs
#   * best_model.zip -> the 12 primary-sweep checkpoints (~16 MB total)
# final_model.zip stays ignored; only best-on-validation is ever evaluated.
!data/raw/*.csv
!results/models_conv/*/*/best_model.zip
